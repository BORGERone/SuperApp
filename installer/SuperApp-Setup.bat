@echo off
REM ===========================================================================
REM  SuperApp - единый графический настройщик (двойной клик).
REM  Открывает окно с полями (предзаполнены рабочими значениями) и кнопками,
REM  которые заменяют отдельные батники: настройка сервера/клиента, установка
REM  и сборка, запуск сервера, запуск HTTPS (Caddy), сброс пароля админа.
REM ===========================================================================
setlocal
cd /d "%~dp0"
set "PATH=%USERPROFILE%\.bun\bin;%PATH%"
powershell -NoProfile -ExecutionPolicy Bypass -STA -File "%~dp0superapp-setup.ps1"
endlocal
