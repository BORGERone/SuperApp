{
  "name": "superapp",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @superapp/client dev",
    "build": "bun run --filter @superapp/client build",
    "build:server": "bun run --filter @superapp/server build",
    "dev:server": "bun run --filter @superapp/server dev",
    "preview": "bun run --filter @superapp/client preview",
    "lint": "bun run --filter '*' lint",
    "test": "bun run --filter '*' test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "cross-env": "^10.1.0",
    "electron": "^22.3.27",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "react-router-dom": "^7.14.2"
  }
}
