# Пример конфигурации сервера SuperApp.
# Скопируйте в packages/server/.env и заполните значения, либо запустите
# installer/install-server (он сгенерирует .env автоматически, включая секрет).
#
# ВАЖНО: .env не должен попадать в git (он в .gitignore). Не храните реальные
# секреты в .env.example.

# Порт, который слушает сервер.
PORT=3002

# Интерфейс привязки. 0.0.0.0 — слушать все интерфейсы (для сервера),
# 127.0.0.1 — только локально.
HOST=0.0.0.0

# В production обязателен криптостойкий секрет (≥ 16 символов). Сгенерировать:
#   bun run packages/server/scripts/gen-secret.ts
# или установщиком. Никогда не используйте значение по умолчанию в проде.
JWT_SECRET=

# Включает строгие проверки безопасности (отказ старта без JWT_SECRET).
NODE_ENV=production

# Список разрешённых CORS-источников через запятую (для веб-клиента).
# Пусто = значения по умолчанию (http://localhost:8080,http://localhost:3000).
# '*' разрешает любой источник, но тогда credentials автоматически отключаются.
CORS_ORIGINS=

# Лимит размера тела запроса/ответа в байтах (по умолчанию 500 МБ).
MAX_BODY_BYTES=524288000
