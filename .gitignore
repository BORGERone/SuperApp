node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun.lock
package-lock.json

# Build outputs
dist/
dist-electron/
build/
target/
*.log

# Артефакты сборки установщиков (zip сервера, .exe клиента)
installer/dist/

# Рантайм HTTPS (setup-https.bat): скачанный Caddy и сгенерированный конфиг
installer/caddy.exe
installer/Caddyfile.local
installer/caddy_data/

# Environment variables
.env
.env.local
.env.*.local
!.env.example

# Локальная конфигурация клиента (адрес сервера)
packages/client/config.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Uploads
uploads/*
!uploads/.gitkeep

# Test files
test*.txt
test*.html
test*.cjs
test*.js

# Logs
*.log
electron.log
server.log

# Temporary files
*.tmp
*.temp
SuperApp/
SupperApp/

# Живая база данных SuperApp: файл лежит рядом с кодом, но живёт ТОЛЬКО на
# сервере. В git его хранить нельзя — иначе каждый pull подменяет базу.
# Подробности и порядок действий: installer\README.md, раздел
# «База данных, загрузки и git».
#
# Вторая строка закрывает *.db-wal / *.db-shm / *.db-journal (режим WAL) и
# *.db.before-restore — страховочную копию, которую делает installer\db-backup.bat.
packages/server/src/db/*.db
packages/server/src/db/*.db.*

# Файлы, загруженные пользователями (рантайм-данные сервера, не код).
packages/server/uploads/*
!packages/server/uploads/.gitkeep

# Локальные резервные копии базы (installer\db-backup.bat)
installer/backups/
